# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Twilio Verify — server-only secrets; never use the TWILIO values in VITE_* variables
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_VERIFY_SERVICE_SID="VA..."

# eSIMAccess API
ESIM_ACCESS_API_KEY="your-esimaccess-api-key"
ESIM_ACCESS_BASE_URL="https://api.esimaccess.com/api/v1/open"
ESIM_ACCESS_WEBHOOK_SECRET="your-webhook-signing-secret"
# Local development only; keep false or unset in staging/production.
ALLOW_UNSIGNED_ESIM_WEBHOOKS="false"

# Brevo (transactional email)
BREVO_API_KEY="xkeysib-..."
FROM_EMAIL="noreply@passportsim.io"
FROM_NAME="PassportSIM"

# Cron job auth (protects admin-only endpoints)
CRON_SECRET="a-random-secret-for-cron-calls"
# Development-only escape hatch; keep unset in staging/production
ALLOW_UNAUTHENTICATED_CRON="false"

# Payments (server-only; Paystack default for Africa)
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_CURRENCY="USD"
PAYSTACK_CALLBACK_URL="https://your-domain.example/payment"
PUBLIC_APP_URL="https://your-domain.example"
# Use `paystack` for controlled-pilot/production; `legacy` preserves existing deployments.
PAYMENT_PROVIDER="paystack"
VITE_PAYMENT_PROVIDER="paystack"
VITE_SUPPORT_PHONE="+254700000000"

# Existing Stripe checkout compatibility (only needed when using legacy mode)
STRIPE_SECRET_KEY="sk_test_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
